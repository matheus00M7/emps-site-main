# API NestJS compartilhada pelo painel e pelo aplicativo.
# Para abrir o painel em outro aparelho, use http://IP-DO-COMPUTADOR:3001
# e autorize a origem correspondente em backend/CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3001

# O padrão usa PostgreSQL/API reais. Use true somente para navegar com mocks.
NEXT_PUBLIC_EMPS_DEMO_MODE=false
