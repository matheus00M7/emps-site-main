# PostgreSQL local iniciado pelo docker-compose.yml da raiz.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emps_db?schema=public"

# Gere um valor aleatório próprio. Nunca reutilize este exemplo em produção.
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30
PORT=3001

# Origens de navegador, separadas por vírgula. Para abrir o painel na LAN,
# acrescente http://IP-DO-COMPUTADOR:3000. Apps nativos não usam localhost.
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Funciona localmente sem movimentar dinheiro.
# Use "stripe" somente depois de configurar cliente, credenciais e webhook.
PAYMENT_PROVIDER="sandbox"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Sem URL, comandos são aceitos pelo simulador local e registrados no banco,
# mas nenhum carregador físico é liberado.
# OCPP_GATEWAY_URL="https://csms.exemplo.com"
# OCPP_GATEWAY_TOKEN="replace-with-gateway-token"
